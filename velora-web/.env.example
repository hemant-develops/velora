# VELORA public website -- required environment variables.
# Copy this file to .env.local and fill in real values from the Supabase
# project dashboard (Project Settings -> API). This is the SAME Supabase
# project the mobile app and velora-admin use.

# Supabase project URL (Project Settings -> API -> Project URL).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (Project Settings -> API -> Project API keys).
# Must be the anon key, never the service_role key -- this site (including
# a signed-in visitor's own session) never holds anything more privileged.
# What an anonymous visitor can read is enforced by
# supabase/migrations/0025_public_website_read_access.sql in the main repo --
# that migration must be applied before this site will show any real data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Login (Google + phone OTP) uses the SAME Supabase Auth project as the
# mobile app -- no separate config needed here beyond the two vars above.
# Google sign-in additionally requires the Google provider to be enabled in
# Supabase Dashboard -> Authentication -> Providers, with this site's
# /auth/callback url added to both Supabase's and Google Cloud Console's
# allowed redirect URLs. Phone OTP requires the same SMS provider (Twilio/
# MSG91/etc.) already configured for the mobile app's phone login -- if
# that's already set up, phone login here needs nothing extra.

# Owner subscription payments (Razorpay) are created and verified entirely
# server-side by supabase/functions/create-subscription-order and
# verify-subscription-payment -- see those files' own comments for the
# `supabase secrets set RAZORPAY_KEY_ID=... / RAZORPAY_KEY_SECRET=...`
# one-time setup. Nothing Razorpay-related belongs in this .env file.

# This site's own public base URL (used only for the sitemap/robots.txt and
# canonical links -- e.g. "https://velora.com"). Defaults to a placeholder
# if unset so local dev still works without it.
NEXT_PUBLIC_SITE_URL=
