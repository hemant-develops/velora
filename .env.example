# VELORA mobile app -- required environment variables.
# Copy this file to .env and fill in real values from the Supabase project
# dashboard (Project Settings -> API). Never commit the real .env file --
# it is already covered by .gitignore.

# Supabase project URL (Project Settings -> API -> Project URL).
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/publishable key (Project Settings -> API -> Project API keys).
# This key is meant to be public/embedded in a client app -- Row Level
# Security policies on the database are what actually restrict access, not
# secrecy of this value. Never put the service_role key here or anywhere in
# this app.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
