{
  "expo": {
    "name": "VELORA",
    "slug": "velora-rental",
    "scheme": "velora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.velora.rental",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "android": {
      "package": "com.velora.rental",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F4C728",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "VELORA needs access to your photos so you can add pictures when listing a car.",
          "cameraPermission": "VELORA needs access to your camera so you can take pictures when listing a car."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VELORA uses your location so you can set your pickup city with one tap."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#F4C728"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "VELORA needs access to your microphone so you can send a voice message in chat."
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-updates"
    ],
    "extra": {
      "eas": {
        "projectId": "36c9d1ca-21e3-4de2-9607-7bbd495ae5c0"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/36c9d1ca-21e3-4de2-9607-7bbd495ae5c0"
    }
  }
}
